<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/widgetBackground"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent"
  android:orientation="horizontal"
  android:theme="@style/AppTheme.AppWidgetContainer"
  style="@style/Widget.Android.AppWidget.Container">

  <LinearLayout
    android:id="@+id/widgetContent"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="3"
    android:background="?android:attr/colorAccent"
    android:theme="@style/MediaPlayerWidgetTheme"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/widgetAlbumArt"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="2"
      android:scaleType="centerCrop"
      android:src="@drawable/icon"
      android:contentDescription="@null" />

    <!-- Readout: weighted as before plus a fixed 36dp (the former icon column), so the cover keeps its width and the text gains it -->
    <LinearLayout
      android:id="@+id/widgetReadout"
      android:layout_width="36dp"
      android:layout_height="match_parent"
      android:layout_weight="3"
      android:layout_marginVertical="8dp"
      android:orientation="vertical"
      android:gravity="center_vertical">

      <TextView
        android:id="@+id/widgetArtistText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="bottom"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_artist"/>

      <TextView
        android:id="@+id/widgetMediaTitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="top"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_title"/>

      <!-- Controls row: the buttons keep their width (end margin = the former 36dp icon column); the brand icon sits in that margin -->
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4">

        <LinearLayout
          android:id="@+id/widgetButtonContainer"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginEnd="36dp"
          android:orientation="horizontal"
          android:background="?android:attr/colorAccent"
          android:theme="@style/MediaPlayerWidgetTheme">

          <ImageView
            android:id="@+id/widgetRewindButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/exo_icon_rewind"
            android:contentDescription="@string/action_jump_backward" />

          <ImageView
            android:id="@+id/widgetPlayPauseButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_media_play_dark"
            android:contentDescription="@string/widget_play_pause" />

          <ImageView
            android:id="@+id/widgetFastForwardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/exo_icon_fastforward"
            android:contentDescription="@string/action_jump_forward" />
        </LinearLayout>

        <ImageView
          android:id="@+id/tinyCornerIcon"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_gravity="end|center_vertical"
          android:layout_marginEnd="10dp"
          android:adjustViewBounds ="true"
          android:src="@drawable/icon_monochrome"
          android:contentDescription="@null" />
      </FrameLayout>

    </LinearLayout>

  </LinearLayout>
</LinearLayout>
