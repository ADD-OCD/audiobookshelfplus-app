<!-- LLAMA expanded full: same structure, ids and actions as media_player_widget_full_expanded.xml; equipment paint only. -->
<!-- UseAppTint: RemoteViews inflate platform ImageViews, where android:tint is the attribute that works (app:tint needs AppCompat). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/widgetBackground"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent"
  android:orientation="vertical"
  android:theme="@style/AppTheme.AppWidgetContainer"
  style="@style/Widget.Android.AppWidget.Container"
  android:background="@drawable/widget_llama_chassis"
  tools:ignore="UseAppTint">

  <!-- Content plus the floating brand icon (it takes no width or height from the content; the renderer shows it
       only where it clears the cover and the text, see FullArtwork) -->
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
      android:id="@+id/widgetContent"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="8dp">

      <!-- Flexible area: the cover grows into this space within the bounds the renderer sets (FullArtwork); once it
           stops growing, it sits on its readout and any spare height goes above it -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical">

        <!-- Expanded artwork: as large as the space allows, at the cover's own aspect (no crop); the frame hugs it -->
        <ImageView
          android:id="@+id/widgetAlbumArt"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:adjustViewBounds="true"
          android:maxWidth="@dimen/widget_full_artwork_max"
          android:maxHeight="@dimen/widget_full_artwork_max"
          android:padding="2dp"
          android:background="@drawable/widget_llama_artwork_frame"
          android:cropToPadding="true"
          android:scaleType="fitCenter"
          android:contentDescription="@null"
          android:src="@drawable/icon" />
      </LinearLayout>

      <!-- Readout below the cover, across the full content width (the brand icon floats above, outside this flow) -->
      <LinearLayout
        android:id="@+id/widgetReadout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="@drawable/widget_llama_readout"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
          android:id="@+id/widgetMediaTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="@color/widget_llama_text"
          android:textSize="16sp"
          android:textStyle="bold"
          tools:text="Title" />

        <TextView
          android:id="@+id/widgetArtistText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/widget_llama_text_muted"
          android:textSize="13sp"
          tools:text="Artist" />

        <LinearLayout
          android:id="@+id/widgetTimeRow"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/widgetElapsedText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_llama_accent"
            android:textSize="13sp"
            tools:text="0:00" />

          <TextView
            android:id="@+id/widgetRemainingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_llama_accent"
            android:textSize="13sp"
            tools:text="-0:00" />
        </LinearLayout>
      </LinearLayout>

      <ProgressBar
        android:id="@+id/widgetProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_llama_progress" />

      <LinearLayout
        android:id="@+id/widgetButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/widgetRewindButton"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:layout_margin="4dp"
          android:padding="10dp"
          android:background="@drawable/widget_llama_button"
          android:tint="@color/widget_llama_legend"
          android:contentDescription="@string/action_jump_backward"
          android:src="@drawable/exo_icon_rewind" />

        <ImageView
          android:id="@+id/widgetPlayPauseButton"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:layout_margin="4dp"
          android:padding="10dp"
          android:background="@drawable/widget_llama_button_primary"
          android:tint="@color/widget_llama_legend"
          android:contentDescription="@string/widget_play_pause"
          android:src="@drawable/ic_media_play_dark" />

        <ImageView
          android:id="@+id/widgetFastForwardButton"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:layout_margin="4dp"
          android:padding="10dp"
          android:background="@drawable/widget_llama_button"
          android:tint="@color/widget_llama_legend"
          android:contentDescription="@string/action_jump_forward"
          android:src="@drawable/exo_icon_fastforward" />
      </LinearLayout>
    </LinearLayout>

    <ImageView
      android:id="@+id/tinyCornerIcon"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_gravity="top|end"
      android:layout_marginTop="@dimen/widget_floating_icon_inset"
      android:layout_marginEnd="@dimen/widget_floating_icon_inset"
      android:adjustViewBounds="true"
      android:tint="@color/widget_llama_text_muted"
      android:contentDescription="@null"
      android:src="@drawable/icon_monochrome" />
  </FrameLayout>
</LinearLayout>
