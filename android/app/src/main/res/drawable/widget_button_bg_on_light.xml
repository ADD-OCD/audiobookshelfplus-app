<?xml version="1.0" encoding="utf-8"?>
<!-- RICE (docs/rice-customization.md, "Widget"): widget_button_bg with dark ink instead of white, for light RICE
     palettes on the standard layouts. Same shape, alphas and stroke; selected only by WidgetPaint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="#1A000000" />
  <stroke android:width="1dp" android:color="#40000000" />
  <corners android:radius="12dp" />
</shape>
