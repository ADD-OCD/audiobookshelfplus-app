<?xml version="1.0" encoding="utf-8"?>
<!-- LLAMA widget secondary key (rewind, fast-forward): the app's steel key at widget scale, drawn inside the view's own
     bounds (all key geometry comes from the layout's size, margin and padding), with 4dp corners. Resting, from the
     outside in: a 1dp dark socket, a narrow lit top/left bevel (the socket shows through as the dark bottom/right edge)
     and the steel face lit from the top (generated key colors). Pressed: the bevel inverts (lit bottom/right) and the
     face is cut in, its shade falling from the top. The primary Play/Pause key keeps widget_llama_button_primary. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <corners android:radius="4dp" />
          <solid android:color="@color/widget_llama_edge_dark" />
        </shape>
      </item>
      <item android:bottom="1dp" android:left="2dp" android:right="1dp" android:top="2dp">
        <shape android:shape="rectangle">
          <corners android:radius="4dp" />
          <solid android:color="@color/widget_llama_edge_light_35" />
        </shape>
      </item>
      <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
          <corners android:radius="4dp" />
          <gradient
            android:angle="270"
            android:endColor="@color/widget_llama_key_face"
            android:startColor="@color/widget_llama_key_pressed_shade" />
        </shape>
      </item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <corners android:radius="4dp" />
          <solid android:color="@color/widget_llama_edge_dark" />
        </shape>
      </item>
      <item android:bottom="2dp" android:left="1dp" android:right="2dp" android:top="1dp">
        <shape android:shape="rectangle">
          <corners android:radius="4dp" />
          <solid android:color="@color/widget_llama_edge_light" />
        </shape>
      </item>
      <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
          <corners android:radius="4dp" />
          <gradient
            android:angle="270"
            android:centerColor="@color/widget_llama_key_face"
            android:endColor="@color/widget_llama_key_shade"
            android:startColor="@color/widget_llama_key_lit" />
        </shape>
      </item>
    </layer-list>
  </item>
</selector>
